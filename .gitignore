# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules

./dist
dist-ssr
src-tauri/gen/*
!src-tauri/gen/apple/Assets.xcassets/AppIcon.appiconset/
*.local
target/*
.claude/*
!.claude/skills/
.superpowers/*
.agents/*
/docs/*/*
!/docs/superpowers/**
/src-tauri/chromium/
skills-lock.json

/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# Android signing keys
*.keystore
*.jks
android-app.keystore

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
docs/.vitepress/dist
docs/.vitepress/cache

.idea

# Exclude all markdown files in root directory except README.md
/*.md
!README.md

# backup files
*.backup
.backup

# worktrees
.worktrees

# SpecSnap dev captures
.specsnap/

# Tauri signing keys must NEVER be committed. The literal "~/" folder below
# catches the case where `pnpm tauri signer generate -w "~/.tauri/key"` was
# run in PowerShell — PowerShell doesn't expand `~` and creates a literal
# `~` folder inside the repo (we hit this once and the old key leaked for
# 11 days before being rotated).
/~/
*.key
*.key.pub

# Playwright MCP captures (snapshots, console logs, screenshots from debug sessions)
.playwright-mcp/

# Playwright e2e outputs
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Root-level debug screenshots (defense*, fix-step*, step*, stuck-state*)
/defense*.png
/fix-*.png
/step[0-9]*-*.png
/stuck-state-*.png
